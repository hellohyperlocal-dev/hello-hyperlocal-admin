# ==========================================
# Hello Hyperlocal Admin Portal Environment
# ==========================================

# 1. Supabase (Shared with Mobile App)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only secret — never prefix with NEXT_PUBLIC_, never import into a client component.
# Get this from Supabase Dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 2. Web Application & Invite Delivery
# Base URL of this admin portal (used to construct admin email invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mobile app deep-link scheme, used to build councillor invite links (scheme://invite/<token>)
NEXT_PUBLIC_MOBILE_APP_SCHEME=hello-hyperlocal

# Set to "true" to run in read-only mock data mode without Supabase connection
NEXT_PUBLIC_PREVIEW_MODE=false

# 3. Resend (Email Service for Invites and 2FA/OTP)
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# 4. Cloudflare R2 (Media Storage & Zero Egress Delivery)
# S3-compatible credentials from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=media
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://pub-your-bucket-hash.r2.dev

# 5. Google Analytics 4 (Data API Service Account)
# From Google Cloud IAM Service Account with "Viewer" access to the GA4 Property
GA4_PROPERTY_ID=your-ga4-property-id
GA4_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
